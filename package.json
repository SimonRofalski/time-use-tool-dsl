{
  "name": "time-use-tool",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mock-oidc": "node dev/mock-oidc-provider.mjs",
    "db:up": "docker compose -f compose.dev.yml up -d --wait",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:reset": "node db/scripts/reset.mjs",
    "db:reset-real": "node db/scripts/reset.mjs --real",
    "db:export": "node db/scripts/export-data.mjs",
    "db:migrate": "node db/scripts/migrate.mjs",
    "db:seed": "node db/scripts/seed.mjs",
    "db:test": "node db/tests/run.mjs",
    "db:test-app": "node db/tests/app/run.mjs",
    "db:test-all": "node db/scripts/test-all.mjs",
    "test:edu-id": "node db/tests/e2e/run-edu-id.mjs",
    "test:dsl-stack": "node deploy/dsl/rehearse.mjs",
    "db:pull": "node db/scripts/pull-schema.mjs"
