  "dependencies": {
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "fflate": "^0.8.3",
    "geist": "1.8.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.7.0",
    "next": "16.1.6",
    "next-intl": "^4.14.5",
    "openid-client": "^6.8.8",
    "pg": "8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.6",
    "oidc-provider": "^9.12.2",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
