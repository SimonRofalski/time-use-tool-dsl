# Template for the app's environment.
#   Local development: copy to .env.local; everything is optional (the db defaults point at the
#     compose.dev.yml container, edu-ID at the mock provider if you fill in the SWITCH block).
#   Production / test on the DSL: no env file; the values are set in deploy/dsl/<test|prod>/compose.yml
#     (secrets from the DSL vault). This file lists every variable the app reads. Details: DEPLOY.md.
# Format: KEY=value, no spaces around =. Use passwords/secrets made of letters and digits only (e.g.
# openssl rand -hex 32): characters like @ / : # break the database URLs.

# --- Database (lib/db) ---------------------------------------------------------------------------
# REQUIRED in production: the app login and the service login created by db/bootstrap/bootstrap.sql
# (DSL: database container tut_db of the same stack). Don't put sslmode into the URLs.
# DATABASE_URL=postgresql://tut_prod_app:<password>@tut_db:5432/tut_prod
# DATABASE_SERVICE_URL=postgresql://tut_prod_service:<password>@tut_db:5432/tut_prod
# Migration job / data import / set-admin only (never the app): the owner login
# DATABASE_OWNER_URL=postgresql://tut_prod_owner:<password>@tut_db:5432/tut_prod
# TLS: DSL stack = disable (database in the stack's own network); unset = no TLS (local container);
# a database on another host: verify-full + DATABASE_CA_FILE.
# Allowed: verify-full (recommended: encrypted + server certificate checked), require (encrypted,
# certificate NOT checked), disable. Other values stop the app.
# DATABASE_SSLMODE=disable
# DATABASE_CA_FILE=/run/secrets/db-ca.pem
# Optional: connect timeout / longest wait for a free connection, ms (default 10000)
# DATABASE_CONNECT_TIMEOUT_MS=10000
# Optional pool sizes (defaults 10 / 4; the logins allow 40 / 15 connections)
# DATABASE_POOL_MAX=10
# DATABASE_SERVICE_POOL_MAX=4
# Development only: lib/db refuses non-local database hosts unless this is set
# ALLOW_REMOTE_DB=1

# --- App ----------------------------------------------------------------------------------------
# REQUIRED in production: the public address. Decides the secure session cookie (__Host- prefix on
# https) and is accepted as same-origin by the CSRF check of the API routes.
# APP_ORIGIN=https://time-use-tool.digisus-lab.ch
# REQUIRED in production: random secret for the password-reset decoy questions (unknown e-mails get
# stable fake questions). Generate once, e.g.:  openssl rand -hex 32
# RESET_DECOY_SECRET=

# --- SWITCH edu-ID OIDC (lib/oidc/client.ts, app/api/auth/switch/*) -----------------------------
# Local dev: point these at the mock provider (`npm run mock-oidc`):
#   SWITCH_OIDC_ISSUER_URL=http://localhost:9999
#   SWITCH_OIDC_CLIENT_ID=time-use-tool-dev
#   SWITCH_OIDC_CLIENT_SECRET=dev-secret
#   SWITCH_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/switch/callback
# Production: values from the SWITCH Resource Registry (test issuer https://login.test.eduid.ch/,
# production https://login.eduid.ch/); redirect URI = APP_ORIGIN + /api/auth/switch/callback.
# Left empty, the edu-ID button leads back to the login page with "edu-ID currently unavailable"
# (needs APP_ORIGIN); password login still works. The container needs outbound HTTPS to login.eduid.ch;
# if that goes through an HTTP proxy, also set HTTPS_PROXY, NO_PROXY and NODE_USE_ENV_PROXY=1.
SWITCH_OIDC_ISSUER_URL=
SWITCH_OIDC_CLIENT_ID=
SWITCH_OIDC_CLIENT_SECRET=
SWITCH_OIDC_REDIRECT_URI=
# Optional, default "openid email profile https://eduid.ch/scope/userinfo.read"
# SWITCH_OIDC_SCOPE=
